local Loops = {}
local function startLoop(id, fn, interval)
    if Loops[id] and Loops[id].Running then return end
    Loops[id] = { Running = true }
    task.spawn(function()
        while Loops[id] and Loops[id].Running do
            if Library.Unloaded then break end
            local ok, err = pcall(fn)
            if not ok then warn("[Ouroboros] " .. id .. " err: ", err) end
            task.wait(interval or 1)
        end
    end)
end

local function stopLoop(id)
    if Loops[id] then Loops[id].Running = false end
end

Library:OnUnload(function()
    for k, v in pairs(Loops) do v.Running = false end
end)

