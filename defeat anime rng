    local jumpLoopId = "AntiAFK"
    local function setAntiAFK(enabled)
        if enabled then
            startLoop(jumpLoopId, function()
                task.spawn(function()
                    while Toggles.AntiAFK and Toggles.AntiAFK.Value do
                        if Library.Unloaded then break end
                        pcall(function()
                            local ping = getRemote("AntiAFKActivityPingEvent")
                            if ping then ping:FireServer() end
                        end)
                        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                        if hum then hum.Jump = true hum:ChangeState(Enum.HumanoidStateType.Jumping) end
                        for i = 1, 300 do
                            if not Toggles.AntiAFK.Value or Library.Unloaded then break end
                            task.wait(1)
                        end
                    end
                end)
                notify("Anti-AFK", "Enabled (jump every 5m)", 2)
            end)
        else
            stopLoop(jumpLoopId)
            notify("Anti-AFK", "Disabled", 2)
        end
    end

