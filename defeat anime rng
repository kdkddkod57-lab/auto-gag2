local function selectedSet(opt)
    local sel = opt and opt.Value or {}
    if type(sel) == "string" then return {[sel]=true} end
    if type(sel) == "table" then
        local out = {}
        for k, v in pairs(sel) do
            if type(k) == "string" and v == true then return sel end
            if type(v) == "string" then out[v] = true end
        end
        return out
    end
    return {}
end

